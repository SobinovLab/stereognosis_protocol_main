<?xml version="1.0" encoding="UTF-8" ?>
<!-- This is a config file for defining and generating and experimental session with trials for Stereognosis. -->
<!-- The base tag has the following attributes that apply to the whole experiment:
	`reps` - defines how many times the whole set of trials is repeated. If a dimension is randomly distributed, the values will be independently random in each repetition. Defaults (if absent) to 1.
	`shuffle` - defines whether to shuffle the trials after all of them are generated (default). Otherwise they will be in default order.
	Total number of trials is: number reps TIMES the number of coordinate reps TIMES the number of reps of each control. -->
<stereognosis_session_config name="Pimms" reps="1" shuffle="true">
	<!-- List of coordinates -->
	<!-- Each coordinate is associated with a motor/DOF of the rig. Control tags within each coordinate define the actual kinematic variable set for a trial, for example position, velocity or acceleration. As many as you want (with different names) can be present in one coordinate.
	Attributes:
		`reps` - how many times the sampling of the values within this coordinate is repeated. For example, if a coordinate has two controls and the coordinate `reps` is 2, each combination of controls will appear twice in the resulting session. If set to `0`, the coordinate is skipped. Defaults to `1`.  -->
	<coordinate name="translation_X" >
		<!-- Controls are the dimentions along which the motor will be controlled during the experimental session.
		Attributes:
		`distribution` - defines the behavior of the coordinate control from trial to trial. Required, can be set to:
			`const` - constant value defined by `default` attribute. If boundaries [min,max] are provided, the script will bound the default to the range.
			`uniform` - uniformly distributed RANDOM values from `min` to `max`. Each time a value for this parameter is needed, a random number generator is called, i.e. the values are not repeated. The number of times this control is used be set by `N` or `reps` tags.
			`grid` - `N` uniformly distributed values on a grid from `min` to `max` OR a space-separated array `values`. `values` takes priority and overrides N-min-max. `values` will be constrained by the min and max, if provided
		`reps` - repeats the values generated by this control. -->
		<control name="position" distribution="grid" N="1" reps="1" min="60" max="90" values="90" />
		<!-- <control name="speed" distribution="const" min="1" max="10" default="2" />
		<control name="acceleration" distribution="const" min="1" max="10" default="2" /> -->
	</coordinate>
	<coordinate name="tilt" reps="1">
		<control name="position" distribution="grid" N="1" reps="1" min="-30" max="30" values="0" />
	</coordinate>
	<coordinate name="aperture" reps="1">
		<control name="position" distribution="grid" N="1" reps="1" min="0" max="10" values="0"/>
	</coordinate>
	<coordinate name="total_force" reps="1">
		<control name="position" distribution="grid" N="1" reps="1" min="0" max="10" values="1 2 3"/>
	</coordinate>
	<coordinate name="total_force_2" reps="1">
		<control name="position" distribution="grid" N="1" reps="1" min="0" max="10" values="1 2 3"/>
	</coordinate>
	<coordinate name="total_force_3" reps="1">
		<control name="position" distribution="grid" N="1" reps="1" min="0" max="10" values="1 2 3"/>
	</coordinate>
	<coordinate name="total_force_rel_min_bound" reps="1">
		<control name="position" distribution="grid" N="1" reps="1" min="-10" max="10" values="-0.25"/>
	</coordinate>
	<coordinate name="total_force_rel_max_bound" reps="1">
		<control name="position" distribution="grid" N="1" reps="1" min="0" max="100" values="100"/>
	</coordinate>
</stereognosis_session_config>
